{
  "opencollection": "1.0.0",
  "info": {
    "name": "LiveRamp Activation Deliveries Segments API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.liveramp.com/activation/v2/v2/segments"
          },
          "docs": "List segments"
        },
        {
          "info": {
            "name": "Get segment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.liveramp.com/activation/v2/v2/segments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get segment"
        },
        {
          "info": {
            "name": "Get segment statuses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.liveramp.com/activation/v2/v2/segments/statuses"
          },
          "docs": "Get segment statuses"
        }
      ]
    }
  ],
  "bundled": true
}